KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Optional -- only for a headless/cloud session that can't run the interactive
# login (no browser, nobody at the keyboard). Generate it where you CAN log in:
# `python3 -m src.auth` prints "KITE_ACCESS_TOKEN=..." and caches it. Set that
# value as an environment variable there. Kite expires it overnight, so prefer a
# real env var over a line in .env -- a stale one in .env just fails every
# morning until you notice. With this set, KITE_API_SECRET is not needed at all:
# the secret only signs the login exchange, so it can stay on your own machine.
# KITE_ACCESS_TOKEN=

# Telegram. Optional for live.py/shadow.py (alerts only -- both run fine
# without it), but REQUIRED for the phone control bot (scripts/run_bot.py).
# TELEGRAM_CHAT_ID is a security control as well as an address: the control
# bot drops commands from every other chat. See deploy/README.md for how to
# get both values from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
